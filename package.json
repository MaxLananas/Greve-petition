{
  "name": "leborgne-en-action",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "La pétition de Leborgne en Action — lycée Yves Leborgne, Guadeloupe.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs cloudflare/*.test.mjs",
    "test:browser": "npm run build && npm run cloudflare:build && node scripts/check-browser.mjs --cloudflare",
    "check": "tsc -b",
    "cloudflare:build": "node scripts/build-cloudflare.mjs",
    "cloudflare:db:local": "wrangler d1 execute DB --local --config wrangler.local.jsonc --file migrations/0001_signatures.sql",
    "cloudflare:dev": "npm run build && npm run cloudflare:db:local && wrangler pages dev dist --config wrangler.local.jsonc --ip 0.0.0.0 --port 3000",
    "test:cloudflare": "npm run cloudflare:build && node --test tests/cloudflare-runtime.test.mjs",
    "test:browser:node": "npm run build && node scripts/check-browser.mjs",
    "export:signatures": "node --env-file-if-exists=.env scripts/export-signatures.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.2-beta",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.150.0"
  }
}
