{
  "name": "leborgne-en-action",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "La pétition de Leborgne en Action — lycée Yves Leborgne, Guadeloupe.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:browser": "npm run build && node scripts/check-browser.mjs",
    "check": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
