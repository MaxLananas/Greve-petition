# Modèle de configuration — copiez vers `.env` (jamais commité) pour le dev local.
# Le serveur et le site utilisent le même port et la même origine.
PORT=3000
# Dossier privé, hors des fichiers publics. À placer sur un volume persistant.
DATABASE_PATH=./data/signatures.sqlite
# Premier palier visuel, et non un nombre de signatures prérempli.
SIGNATURE_GOAL=1000
# Adresse réelle de l'équipe responsable, à renseigner avant la mise en ligne.
CONTACT_EMAIL=
# URL publique, pour les liens de partage et les métadonnées (sans slash final).
PUBLIC_URL=
# Nombre de reverse proxies de confiance. 0 par défaut ; à adapter à l'hébergement.
TRUST_PROXY=0
# Limite d'envois par IP sur 10 minutes, à adapter si le lycée partage une seule connexion.
SIGNATURE_RATE_LIMIT=60
# Secret d'au moins 32 caractères pour l'export CSV privé. Vide = export désactivé.
ADMIN_TOKEN=
# Protection anti-robot Cloudflare Turnstile (optionnelle ; vide = désactivée).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Production : Cloudflare Pages + Supabase (tableau de bord Pages) ----
# Ces variables se renseignent dans Pages → Settings → Environment Variables
# (Production), PAS dans un fichier .env. Voir DEPLOY-TUTORIAL.md.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# SIGNATURE_RATE_SECRET=... (chaîne aléatoire, anti-abus distribué)
# CONTACT_EMAIL, PUBLIC_URL=https://..., ADMIN_TOKEN (≥ 32 caractères),
# SIGNATURE_GOAL, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY (optionnel)
